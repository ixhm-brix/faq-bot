# --- DeepSeek -------------------------------------------------------------
DEEPSEEK_API_KEY=paste-your-deepseek-key-here

# --- Portal ---------------------------------------------------------------
PORTAL_ADMIN_USERNAME=admin
PORTAL_ADMIN_PASSWORD=changeme
PORTAL_SESSION_SECRET=

# Shared secret for the public POST /widget/chat endpoint. When set, callers
# must send it in the X-API-Key header (else 401). Leave unset to keep the
# endpoint open for local dev (the portal logs a warning at startup).
WIDGET_API_KEY=

# --- Knowledge base -------------------------------------------------------
# Generated by the site's `npm run build:kb` and served with the site, so the
# bot and the page can never disagree about a price. Fetched once at startup;
# data/kb.txt is the committed fallback for a boot with no network.
KB_URL=https://briqx.ninja/kb.txt
KB_FETCH_TIMEOUT=10

# --- Token management -----------------------------------------------------
# Answers are meant to be 2-4 sentences. Output tokens are the most expensive
# part of a request, so this cap is the main lever on cost per message.
MAX_OUTPUT_TOKENS=800

# Conversation window sent with each request. The old 12-hour / 20-message
# history was re-sent every turn and was the largest silent token drain.
HISTORY_TURNS=3
HISTORY_CHAR_CAP=1200

# Longest question accepted. Anything longer is rejected locally, for free.
MAX_INPUT_CHARS=600

# --- Spend protection -----------------------------------------------------
RATE_LIMIT_PER_MINUTE=8
RATE_LIMIT_PER_DAY=60

# Global daily ceiling on DeepSeek calls. Per-IP limits do not bound total
# spend when a caller rotates addresses; this does. Once reached, the widget
# serves published prices/FAQ and the WhatsApp handoff until UTC midnight.
DAILY_API_CALL_CAP=1500

# --- Human handoff --------------------------------------------------------
# WhatsApp is a PERSON, deliberately — no bot on the other end. International
# format, digits only. The visitor's question is prefilled into the chat.
WHATSAPP_NUMBER=250729247124

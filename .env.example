TELEGRAM_BOT_TOKEN=paste-your-token-from-BotFather-here
DEEPSEEK_API_KEY=paste-your-deepseek-key-here
PORTAL_ADMIN_USERNAME=admin
PORTAL_ADMIN_PASSWORD=changeme
PORTAL_SESSION_SECRET=

# Shared secret for the public POST /widget/chat endpoint. When set, callers
# must send it in the X-API-Key header (else 401). Leave unset to keep the
# endpoint open for local dev (the portal logs a warning at startup).
WIDGET_API_KEY=

# Voice notes (Whisper speech-to-text). All optional — sensible defaults apply.
# VOICE_MODEL_SIZE: tiny | base | small | medium | large-v3   (default: base)
# VOICE_DEVICE: cpu | cuda  — set cuda to use a GPU (needs CUDA 12 + cuDNN 9)
# VOICE_COMPUTE_TYPE: int8 (CPU default) | float16 (GPU default) | float32
VOICE_MODEL_SIZE=base
VOICE_DEVICE=cuda
